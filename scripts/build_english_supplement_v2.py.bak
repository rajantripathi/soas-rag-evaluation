#!/usr/bin/env python3
from __future__ import annotations

import argparse
import gzip
import json
from pathlib import Path

from src.utils import ensure_dir, read_jsonl, write_jsonl


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Build English supplementary corpus from raw MIRACL documents."
    )
    parser.add_argument("--eval-file", default="data/eval/manual_eval_v5.jsonl")
    parser.add_argument("--base-corpus-file", default="data/processed/corpus_manual_v1_uzsupp_v2.jsonl")
    parser.add_argument("--miracl-path", default="data/raw/miracl_en/miracl-corpus-v1.0-en")
    parser.add_argument(
        "--domains",
        nargs="+",
        default=["history", "institutions", "governance"],
        help="English domains to include from the eval file.",
    )
    parser.add_argument("--language", default="en")
    parser.add_argument(
        "--output",
        default="data/processed/corpus_english_supplement_v2.jsonl",
    )
    parser.add_argument(
        "--max-chars",
        type=int,
        default=4000,
        help="Trim source text to a lead passage to keep indexing stable on cluster login nodes.",
    )
    return parser


def lead_passage(text: str, max_chars: int) -> str:
    cleaned = " ".join((text or "").split())
    if len(cleaned) <= max_chars:
        return cleaned
    clipped = cleaned[:max_chars]
    for marker in [". ", "! ", "? ", "; "]:
        idx = clipped.rfind(marker)
        if idx >= max_chars // 2:
            return clipped[: idx + 1].strip()
    return clipped.strip()


def load_miracl_by_title(miracl_path: Path) -> dict[str, dict]:
    """Load all MIRACL documents into a dictionary keyed by title."""
    docs_by_title = {}
    for gzip_path in sorted(miracl_path.glob("docs-*.jsonl.gz")):
        print(f"Loading {gzip_path}...")
        with gzip.open(gzip_path, "rt", encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                doc = json.loads(line)
                title = doc.get("title")
                doc_id = doc.get("docid") or doc.get("id")
                if title and doc_id:
                    # Store the first passage (usually #0) as the main document
                    if "#" in str(doc_id) and str(doc_id).endswith("#0"):
                        docs_by_title[str(title)] = doc
    print(f"Loaded {len(docs_by_title)} unique documents from MIRACL")
    return docs_by_title


def main() -> int:
    args = build_parser().parse_args()
    eval_rows = read_jsonl(args.eval_file)
    base_rows = read_jsonl(args.base_corpus_file)
    base_ids = {row["doc_id"] for row in base_rows}
    wanted_domains = set(args.domains)

    target_titles: dict[str, dict] = {}
    for row in eval_rows:
        if row["language"] != args.language or row["domain"] not in wanted_domains:
            continue
        if not row.get("source_doc_ids"):
            continue
        doc_id = str(row["source_doc_ids"][0])
        if doc_id in base_ids:
            continue
        # Use source_title if available, otherwise use doc_id
        title = row.get("source_title", doc_id)
        if title not in target_titles:
            target_titles[title] = []
        target_titles[title].append({
            "doc_id": doc_id,
            "target_domain": row["domain"],
            "from_eval_id": row["id"],
            "question": row["question"],
        })

    print(f"Found {len(target_titles)} unique missing English titles")
    
    # Load MIRACL documents by title
    miracl_docs = load_miracl_by_title(Path(args.miracl_path))
    
    rows = []
    unresolved = []
    per_domain = {d: 0 for d in args.domains}
    per_domain_unresolved = {d: 0 for d in args.domains}
    
    for title, eval_items in target_titles.items():
        if title in miracl_docs:
            doc = miracl_docs[title]
            # Extract text from MIRACL document
            text = doc.get("text") or ""
            
            # Create a corpus document for each eval item that needs this title
            for item in eval_items:
                rows.append({
                    "doc_id": item["doc_id"],
                    "chunk_id": f"{item[doc_id]}::0",
                    "source": "miracl_english_supplement_v2",
                    "language": args.language,
                    "title": str(title),
                    "text": lead_passage(str(text), max_chars=args.max_chars),
                    "metadata": {
                        "source_type": "miracl_raw",
                        "target_domain": item["target_domain"],
                        "from_eval_id": item["from_eval_id"],
                        "question": item["question"],
                        "url": doc.get("url") or "",
                        "max_chars": args.max_chars,
                    },
                })
                per_domain[item["target_domain"]] += 1
        else:
            for item in eval_items:
                unresolved.append(item["doc_id"])
                per_domain_unresolved[item["target_domain"]] += 1
    
    rows.sort(key=lambda row: row["doc_id"])
    ensure_dir(Path(args.output).parent)
    write_jsonl(args.output, rows)
    
    print(f"\n=== English Supplement v2 Results ===")
    print(f"Output: {args.output}")
    print(f"Resolved documents: {len(rows)}")
    print(f"Unresolved documents: {len(unresolved)}")
    print(f"\nPer-domain breakdown:")
    for domain in args.domains:
        print(f"  {domain}: {per_domain[domain]} resolved, {per_domain_unresolved[domain]} unresolved")
    
    if unresolved:
        if unresolved:
            unresolved_str = ", ".join(sorted(set(unresolved))))
            print(f"\nUnresolved doc_ids: {unresolved_str}")
    
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
